<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SignalMonitorTest1.MainPage"
             Title="Wi-Fi toggle test">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label x:Name="ServiceLabel" FontSize="16" />
            <Label x:Name="WifiLabel" FontSize="16" />

            <Button Text="1. Open accessibility settings"
                    Clicked="OnOpenSettingsClicked" />

            <Button x:Name="ToggleNowButton"
                    Text="2. Toggle Wi-Fi now"
                    Clicked="OnToggleNowClicked" />

            <Button x:Name="DelayedToggleButton"
                    Text="3. Toggle in 10 s (turn screen off)"
                    Clicked="OnDelayedToggleClicked" />

            <Button Text="Refresh status"
                    Clicked="OnRefreshClicked" />

            <Label Text="Log" FontAttributes="Bold" Margin="0,12,0,0" />
            <Label x:Name="LogLabel" FontFamily="monospace" FontSize="12" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
